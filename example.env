# Copy to .env and fill in. Never commit .env.
# cp example.env .env

# Required — Gemini API key (Google AI Studio)
# Create at: https://aistudio.google.com/apikey
BLANKFLOAT_API_KEY=

# Defaults: Gemini 3.5 Flash-Lite via OpenAI-compatible endpoint.
BLANKFLOAT_MODEL=gemini-3.5-flash-lite
BLANKFLOAT_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# Cheaper/older lite alternative:
# BLANKFLOAT_MODEL=gemini-3.1-flash-lite

# Z.AI / GLM (optional):
# BLANKFLOAT_MODEL=glm-4.6v-flash
# BLANKFLOAT_BASE_URL=https://api.z.ai/api/paas/v4
